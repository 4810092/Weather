<resources>
    <style name="Theme.Nimbo.Wear" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/weather_background</item>
        <item name="android:colorAccent">@color/weather_accent</item>
    </style>

    <style name="Theme.Nimbo.Wear.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_screen</item>
        <item name="postSplashScreenTheme">@style/Theme.Nimbo.Wear</item>
    </style>
</resources>
