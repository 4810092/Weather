{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nimbo.uz/schemas/store-metadata-v2.json",
  "title": "Nimbo store metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "metadata_revision",
    "product",
    "localizations",
    "creative_sets",
    "experiments",
    "listings"
  ],
  "properties": {
    "$schema": {
      "const": "./metadata.schema.json"
    },
    "schema_version": {
      "const": 2
    },
    "metadata_revision": {
      "type": "string",
      "format": "date"
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "release",
        "urls"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "release": {
          "type": "string",
          "minLength": 1
        },
        "urls": {
          "$ref": "#/$defs/urls"
        }
      }
    },
    "localizations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/localization"
      }
    },
    "creative_sets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "manifest",
          "platforms",
          "audience_locales",
          "support_url"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "manifest": {
            "type": "string",
            "minLength": 1
          },
          "platforms": {
            "$ref": "#/$defs/platforms"
          },
          "audience_locales": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "support_url": {
            "$ref": "#/$defs/httpsUrl"
          }
        }
      }
    },
    "experiments": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/experiment"
      }
    },
    "listings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/listing"
      }
    }
  },
  "$defs": {
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://"
    },
    "urls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "marketing",
        "support",
        "privacy"
      ],
      "properties": {
        "marketing": {
          "$ref": "#/$defs/httpsUrl"
        },
        "support": {
          "$ref": "#/$defs/httpsUrl"
        },
        "privacy": {
          "$ref": "#/$defs/httpsUrl"
        }
      }
    },
    "localization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "subtitle",
        "short_description",
        "keywords",
        "description",
        "release_notes"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "subtitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "short_description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "keywords": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "release_notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "app-store",
          "google-play"
        ]
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "platforms",
        "baseline_creative_set",
        "variant_creative_set",
        "single_variable",
        "minimum_weekly_store_visitors",
        "decision_rule"
      ],
      "properties": {
        "status": {
          "enum": [
            "not-started",
            "running",
            "completed",
            "cancelled"
          ]
        },
        "platforms": {
          "$ref": "#/$defs/platforms"
        },
        "baseline_creative_set": {
          "type": "string",
          "minLength": 1
        },
        "variant_creative_set": {
          "type": [
            "string",
            "null"
          ]
        },
        "single_variable": {
          "type": "string",
          "minLength": 1
        },
        "minimum_weekly_store_visitors": {
          "type": "integer",
          "minimum": 0
        },
        "decision_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "listing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "platform",
        "storefront",
        "listing_type",
        "localization_refs",
        "overrides",
        "custom_listing",
        "custom_product_page",
        "creative_set",
        "experiment",
        "marketing_url",
        "support_url",
        "privacy_url"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "enum": [
            "app-store",
            "google-play"
          ]
        },
        "storefront": {
          "type": "string",
          "minLength": 2
        },
        "listing_type": {
          "enum": [
            "default",
            "custom-listing",
            "custom-product-page"
          ]
        },
        "localization_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "overrides": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/localizationOverride"
          }
        },
        "custom_listing": {
          "oneOf": [
            {
              "$ref": "#/$defs/customListing"
            },
            {
              "type": "null"
            }
          ]
        },
        "custom_product_page": {
          "oneOf": [
            {
              "$ref": "#/$defs/customProductPage"
            },
            {
              "type": "null"
            }
          ]
        },
        "creative_set": {
          "type": "string",
          "minLength": 1
        },
        "experiment": {
          "type": [
            "string",
            "null"
          ]
        },
        "marketing_url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "support_url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "privacy_url": {
          "$ref": "#/$defs/httpsUrl"
        }
      }
    },
    "localizationOverride": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "subtitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "short_description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "keywords": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "release_notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "customListing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "country_targets",
        "localizations"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "draft",
            "active",
            "archived"
          ]
        },
        "country_targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          }
        },
        "localizations": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "store_locale_fallback",
              "title",
              "short_description"
            ],
            "properties": {
              "store_locale_fallback": {
                "type": "string",
                "minLength": 2
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 30
              },
              "short_description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            }
          }
        }
      }
    },
    "customProductPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_name",
        "status",
        "audience_locale",
        "store_locale_fallback",
        "promotional_text",
        "keyword_targets"
      ],
      "properties": {
        "reference_name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "draft",
            "submitted",
            "approved",
            "archived"
          ]
        },
        "audience_locale": {
          "type": "string",
          "minLength": 2
        },
        "store_locale_fallback": {
          "type": "string",
          "minLength": 2
        },
        "promotional_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 170
        },
        "keyword_targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
